{
  "name": "thx-remotion-demo",
  "private": true,
  "type": "module",
  "description": "A 40-second THX 1138 control-room film rendered with Remotion from the public thx-components API.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts THX1138 out/thx-1138.mp4 --codec=h264 --jpeg-quality=92",
    "still": "remotion still src/index.ts THX1138"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.544",
    "thx-components": "file:../.."
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
